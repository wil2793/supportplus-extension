{
  "manifest_version": 3,
  "name": "SupportPlus Ticket Exporter",
  "version": "6.3.0",
  "description": "SupportPlus → Monday.com: Migra tickets con un click. Desarrollado por el equipo de Base de Datos (DBA).",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "host_permissions": [
    "https://macropay.supportplus.mx/*",
    "https://macropayapi.supportplus.mx/*",
    "https://api.monday.com/*",
    "https://cdn.sheetjs.com/*",
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "http://localhost:3500/*",
    "https://back-extension-sp.macropay.mx/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/pdf.worker.min.js"],
      "matches": ["https://macropay.supportplus.mx/*"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://macropay.supportplus.mx/*"],
      "js": [
        "dist/xlsx.min.js",
        "dist/pdf.min.js",
        "dist/pdf.worker.min.js",
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
