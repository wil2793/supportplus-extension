{
  "manifest_version": 3,
  "name": "SupportPlus Ticket Exporter",
  "version": "6.0.7",
  "description": "SupportPlus → Monday.com: Migra tickets con un click. Desarrollado por el equipo de Base de Datos (DBA).",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://macropay.supportplus.mx/*",
    "https://macropayapi.supportplus.mx/*",
    "https://api.monday.com/*",
    "https://cdn.sheetjs.com/*",
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "http://localhost:3500/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdf.worker.min.js"],
      "matches": ["https://macropay.supportplus.mx/*"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://macropay.supportplus.mx/*"],
      "js": [
        "xlsx.min.js",
        "pdf.min.js",
        "pdf.worker.min.js",
        "config.js",
        "styles.js",
        "lib/storage.js",
        "lib/logger.js",
        "lib/cache.js",
        "lib/event-bus.js",
        "lib/dom-utils.js",
        "lib/templates.js",
        "components.js",
        "lib/modal-builder.js",
        "lib/api.js",
        "lib/monday-utils.js",
        "features/session.js",
        "features/header-buttons.js",
        "features/row-colors.js",
        "features/manager-view.js",
        "features/detail-view.js",
        "features/ticket-actions.js",
        "features/reports.js",
        "features/guardias.js",
        "content.js",
        "monday-sync.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
