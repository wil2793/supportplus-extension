{
  "manifest_version": 3,
  "name": "SupportPlus Ticket Exporter",
  "version": "3.3.3",
  "description": "SupportPlus → Monday.com: Migra tickets con un click",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://macropay.supportplus.mx/*", "https://macropayapi.supportplus.mx/*", "https://api.monday.com/*", "https://cdn.sheetjs.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://macropay.supportplus.mx/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
